[global_config]
  suppress_multiple_term_dialog = True
  case_sensitive = False
  title_hide_sizetext = True
  inactive_color_offset = 1.0
  handle_size = 1
  tab_position = top
[keybindings]
[profiles]
  [[default]]
    # macOS Terminal "Pro" look
    scrollback_infinite = True
    use_system_font = False
    font = SF Mono 11
    foreground_color = "#f2f2f2"
    background_color = "#000000"
    background_type = transparent
    background_darkness = 0.78
    cursor_color = "#7f7f7f"
    cursor_color_default = False
    cursor_shape = block
    cursor_blink = False
    palette = "#000000:#990000:#00a600:#999900:#2f63e0:#b200b2:#00a6b2:#bfbfbf:#666666:#e50000:#00d900:#e5e500:#5c8dff:#e500e5:#00e5e5:#e5e5e5"
    bold_is_bright = False
    allow_bold = True
    show_titlebar = False
    scrollbar_position = hidden
    copy_on_selection = False
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
      profile = default
[plugins]
