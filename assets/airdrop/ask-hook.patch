+# macish: every transfer is offered to the user first. AIRDROP_ASK_COMMAND
+# is run with the sender's name and what they're sending; exit status 0
+# accepts. Unset, failing or too slow means declined: nothing is received
+# without a yes.
+ASK_COMMAND = shlex.split(os.environ.get('AIRDROP_ASK_COMMAND', ''))
+ASK_TIMEOUT_SECONDS = 90
+
+
+def describe_ask(files, items):
+    """One file by name, or how many, with the total size the sender gave."""
+    files = [f for f in files if isinstance(f, dict)]
+    total = sum(f['FileSize'] for f in files if isinstance(f.get('FileSize'), int))
+    if len(files) == 1:
+        what = str(files[0].get('FileName') or 'a file')
+    elif files:
+        what = f'{len(files)} files'
+    else:
+        links = [i for i in items if isinstance(i, str)]
+        return links[0] if len(links) == 1 else f'{len(links)} links' if links else 'an item'
+    if not total:
+        return what
+    size, unit = float(total), 'bytes'
+    for unit in ('bytes', 'KB', 'MB', 'GB'):
+        if size < 1000 or unit == 'GB':
+            break
+        size /= 1000
+    return f'{what} ({size:.0f} {unit})' if unit == 'bytes' else f'{what} ({size:.1f} {unit})'
+
+
+def user_accepts(ask, files, items):
+    if not ASK_COMMAND:
+        logging.warning('AIRDROP_ASK_COMMAND is not set; declining')
+        return False
+    sender = str(ask.get('SenderComputerName') or 'An Apple device')
+    try:
+        run = subprocess.run(ASK_COMMAND + [sender, describe_ask(files, items)],
+                             stdin=subprocess.DEVNULL, timeout=ASK_TIMEOUT_SECONDS)
+    except (OSError, subprocess.TimeoutExpired) as e:
+        logging.warning('ask command failed (%r); declining', e)
+        return False
+    return run.returncode == 0
+
+
