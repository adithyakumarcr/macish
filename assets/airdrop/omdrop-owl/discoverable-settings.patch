After omdrop-owl PR #64, rebased: /etc/omdrop/tx-rate and /etc/omdrop/election-metric pass owl -R and -M.

diff --git a/userspace/omdrop-discoverable b/userspace/omdrop-discoverable
index 5a95ed7..ecccded 100755
--- a/userspace/omdrop-discoverable
+++ b/userspace/omdrop-discoverable
@@ -671,6 +671,15 @@ cmd_start() {
   if [ "$aggregation" = 1 ] || { [ -z "$aggregation" ] && [ "$PROF_MODE" = active-monitor ] && [ "$drv" = mt76x2u ]; }; then
     owl_extra+=(-A)
   fi
+  # owl -R, -M (PR #64: patches/owl-11-mimo-sgi, owl-12, owl-13): $CONF/tx-rate
+  # sets the data rate (e.g. 54), $CONF/election-metric the sync master metric
+  # (e.g. 550, above an iPhone's 505-536, so this machine stays master). Unset,
+  # OWL keeps its defaults.
+  local rate metric
+  rate=$(knob tx-rate)
+  [ -n "$rate" ] && owl_extra+=(-R "$rate")
+  metric=$(knob election-metric)
+  [ -n "$metric" ] && owl_extra+=(-M "$metric")
 
   # mt76_pm: runtime PM off for the window, restored by stop.
   mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null
